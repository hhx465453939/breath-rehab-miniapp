.page-title { font-size: 34rpx; font-weight: bold; color: #59455A; }
.page-sub { font-size: 24rpx; color: #99A9B7; margin-top: 8rpx; margin-bottom: 24rpx; }
.form-item { margin-bottom: 28rpx; }
.form-label { font-size: 28rpx; font-weight: bold; color: #59455A; margin-bottom: 12rpx; }
.small-label { font-size: 24rpx; margin-top: 16rpx; }
.form-input { background: #FDF6F1; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; border: 2rpx solid #F2C492; }
.opt-row { display: flex; }
.opt-row.wrap { flex-wrap: wrap; }
.opt { background: #FDF6F1; border: 2rpx solid #F2C492; border-radius: 12rpx; padding: 12rpx 28rpx; margin-right: 16rpx; font-size: 28rpx; color: #59455A; }
.opt.small { padding: 10rpx 20rpx; font-size: 24rpx; margin-bottom: 12rpx; }
.opt.active { background: #EA8CA9; border-color: #EA8CA9; color: #fff; }
.hint { background: #F0EAF5; color: #59455A; font-size: 24rpx; padding: 16rpx; border-radius: 12rpx; }
