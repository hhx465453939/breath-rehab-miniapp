.page-title { font-size: 34rpx; font-weight: bold; color: #59455A; }
.page-sub { font-size: 24rpx; color: #99A9B7; margin-top: 8rpx; margin-bottom: 24rpx; }
.ref-box { background: #F0EAF5; border-radius: 16rpx; padding: 20rpx; margin-bottom: 24rpx; }
.ref-title { font-size: 26rpx; font-weight: bold; color: #59455A; margin-bottom: 12rpx; }
.ref-row { display: flex; justify-content: space-between; font-size: 24rpx; padding: 4rpx 0; }
.ref-name { color: #59455A; font-weight: bold; }
.ref-range { color: #7A7EC4; }
.ref-note { font-size: 20rpx; color: #99A9B7; margin-top: 8rpx; }
.skip-tip { background: #FFF3E0; color: #8a5a00; font-size: 24rpx; padding: 16rpx; border-radius: 12rpx; margin-top: 16rpx; }
.test-progress { text-align: center; color: #59455A; font-size: 28rpx; font-weight: bold; margin-bottom: 30rpx; }
.candle-box { display: flex; justify-content: center; align-items: flex-end; height: 280rpx; }
.candle { position: relative; width: 70rpx; height: 160rpx; margin: 0 14rpx; background: linear-gradient(180deg, #EEABC4, #DD7180); border-radius: 10rpx 10rpx 4rpx 4rpx; }
.flame { position: absolute; top: -70rpx; left: 50%; transform: translateX(-50%); width: 24rpx; height: 60rpx; background: radial-gradient(circle, #F6C5DE 0%, #EA8CA9 40%, #F2C492 70%, transparent 100%); border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; animation: flicker 0.3s infinite alternate; }
.flame-small { animation: flicker 0.8s infinite alternate; opacity: 0.6; }
.flame-big { animation: flicker 0.15s infinite alternate; transform: translateX(-50%) scale(1.6); }
.wick { position: absolute; top: -12rpx; left: 50%; transform: translateX(-50%); width: 4rpx; height: 16rpx; background: #59455A; }
.candle.out .flame { display: none; }
.candle.out { background: #D1C7D0; }
@keyframes flicker {
  from { transform: translateX(-50%) rotate(-4deg); }
  to { transform: translateX(-50%) rotate(4deg); }
}
.db-display { text-align: center; font-size: 90rpx; font-weight: bold; color: #DD7180; margin: 30rpx 0; }
.db-unit { font-size: 32rpx; color: #99A9B7; }
.countdown { text-align: center; font-size: 120rpx; font-weight: bold; color: #59455A; margin: 60rpx 0; }
.test-tip { text-align: center; font-size: 26rpx; color: #99A9B7; margin-bottom: 30rpx; min-height: 40rpx; }
.level-result { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #F2C492; }
.lr-name { font-weight: bold; color: #59455A; }
.lr-data { color: #7A7EC4; }
.lr-pos { font-size: 22rpx; color: #99A9B7; }
.overall { display: flex; align-items: center; justify-content: center; margin: 30rpx 0; }
.overall-label { font-size: 30rpx; color: #59455A; margin-right: 16rpx; }
.coach-box { background: #FDF6F1; border: 2rpx solid #F2C492; border-radius: 16rpx; padding: 20rpx; font-size: 26rpx; color: #59455A; margin: 20rpx 0; }
