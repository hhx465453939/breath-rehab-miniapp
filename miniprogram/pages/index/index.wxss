.header { background: linear-gradient(135deg, #59455A, #AD70A0); color: #fff; }
.hello { font-size: 38rpx; font-weight: bold; }
.sub { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }
.row { display: flex; justify-content: space-between; padding: 8rpx 0; }
.label { color: #99A9B7; }
.value.ok { color: #2153B8; font-weight: bold; }
.value.warn { color: #EA8CA9; font-weight: bold; }
.baseline-tip { background: #FFF3E0; border-radius: 12rpx; padding: 16rpx; margin-top: 16rpx; font-size: 24rpx; color: #8a5a00; }
.btn-secondary.mini { margin-top: 12rpx; padding: 8rpx 0; font-size: 26rpx; }
.section-title { font-size: 32rpx; font-weight: bold; margin-bottom: 20rpx; color: #59455A; }
.mode-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.mode-item { width: 48%; background: #FDF6F1; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-sizing: border-box; border: 2rpx solid #F2C492; }
.mode-emoji { font-size: 56rpx; }
.mode-name { font-size: 30rpx; font-weight: bold; margin-top: 8rpx; color: #59455A; }
.mode-desc { font-size: 22rpx; color: #99A9B7; margin-top: 4rpx; }
